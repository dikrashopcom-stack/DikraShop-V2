{
  "name": "dikrashop-shipping",
  "version": "2.0.0",
  "scripts": {
    "start": "ts-node src/scripts/startServer.ts",
    "build": "tsc",
    "process": "ts-node src/scripts/processReadyOrders.ts",
    "retry": "ts-node src/scripts/retryFailedOrders.ts",
    "single": "ts-node src/scripts/processSingleOrder.ts",
    "territories": "ts-node src/scripts/searchTerritories.ts",
    "moon": "ts-node src/scripts/generateMoonDesign.ts",
    "fetch:territories": "ts-node src/scripts/fetchTerritories.ts",
    "fetch:rates": "ts-node src/scripts/fetchRates.ts",
    "fetch:hubs": "ts-node src/scripts/fetchHubs.ts",
    "build:hub-map": "ts-node src/scripts/buildHubPriceMap.ts",
    "build:stop-desks": "ts-node src/scripts/buildStopDesks.ts",
