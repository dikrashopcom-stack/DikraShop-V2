# ─── Runtime ──────────────────────────────────────────────────────────────────
# MUST be "production" on the deployed box — otherwise the Shopify HMAC check
# does NOT fail closed when SHOPIFY_WEBHOOK_SECRET is unset.
NODE_ENV=production

# ─── Notion ───────────────────────────────────────────────────────────────────
NOTION_TOKEN=ntn_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NOTION_DATABASE_ID=e9c1e4b31e8b4fb3894d624e7a82fadb

# ─── ZR Express (shipping) ────────────────────────────────────────────────────
ZR_API_KEY=YOUR_ZR_API_KEY_HERE
ZR_TENANT_ID=YOUR_TENANT_ID_HERE
ZR_BASE_URL=https://api.zrexpress.app/api/v1.0
LABELS_DIR=./labels
BATCH_SIZE=10
LOG_LEVEL=info

# Moon design generator (`npm run moon -- <pageId>`)
OUTPUT_DIR=./output   # where generated PNG files are saved

# ─── Shopify webhook server (required for `npm start` / the deployed service) ──
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
# REQUIRED in production: without it every Shopify webhook is rejected (fail-closed).
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
APP_URL=https://your-public-url.com
PORT=3000

# ─── ZR Express webhook receiver (set after `npm run webhook:register`) ────────
WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx   # Svix signing secret from ZR
ZR_WEBHOOK_URL=https://your-public-url.com/webhooks/zrexpress
ZR_ACCESS_TOKEN=your_zr_bearer_token           # falls back to ZR_API_KEY if unset
